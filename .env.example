# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_test
PORT=3000
# Allowed CORS origin (the Vercel domain when deployed)
CORS_ORIGIN=http://localhost:5173

# Host port for the docker-compose Postgres (change if 5432 is taken, and update the URLs above)
POSTGRES_PORT=5432
