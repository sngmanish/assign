# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_test
PORT=3000
# Allowed CORS origin(s), comma separated (the Vercel domain when deployed). Required in production.
CORS_ORIGIN=http://localhost:5173

# Optional. SSL for the database connection defaults to on when NODE_ENV=production, off otherwise.
# DATABASE_SSL=false
# Optional. Seed 20,000 demo contacts on start when the contacts table is empty (default true).
# SEED_ON_START=true

# Optional. PEM of the database's CA: when set, the TLS certificate is verified.
# DATABASE_CA_CERT=
# Optional. Cancel any single query after this many ms (default 10000).
# STATEMENT_TIMEOUT_MS=10000
# Optional. Requests per minute per client, and for bulk assign (defaults 300 / 20).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_BULK_MAX=20
# How many proxies sit in front of the API (0-5), so rate limits are per visitor. 2 on Railway (measured).
# Never "trust everything": clients could then choose their own address.
# TRUST_PROXY_HOPS=0
# Serve Swagger UI at /docs (default true).
# ENABLE_DOCS=true

# Host port for the docker-compose Postgres (change if 5432 is taken, and update the URLs above)
POSTGRES_PORT=5432
